# Application Configuration
APP_NAME=Medical Diagnosis Pipeline
APP_VERSION=1.0.0
DEBUG=False

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Database (PostgreSQL)
DB_USER=postgres
DB_PASSWORD=secure_password_here
DB_HOST=localhost
DB_PORT=5432
DB_NAME=medical_diagnosis

# Vector Store (Redis for embeddings)
VECTOR_DB_HOST=localhost
VECTOR_DB_PORT=6379

# Azure Configuration
AZURE_SUBSCRIPTION_ID=your_subscription_id
AZURE_RESOURCE_GROUP=your_resource_group
AZURE_STORAGE_ACCOUNT=yourstorageaccount
AZURE_STORAGE_KEY=your_storage_key
AZURE_BLOB_CONTAINER=medical-images
AZURE_KEY_VAULT_URL=https://your_keyvault.vault.azure.net/

# ML Model Configuration
# Change these to use different models from HuggingFace Hub
GLAUCOMA_MODEL_NAME=google/vit-base-patch16-224
GLAUCOMA_MODEL_VERSION=1.0.0

LLM_MODEL_NAME=mistralai/Mistral-7B-Instruct-v0.1
LLM_MODEL_VERSION=1.0.0

# Model Loading
LOAD_MODELS_ON_STARTUP=True
MODEL_CACHE_DIR=./model_cache
MODEL_DEVICE=cuda

# Security
SECRET_KEY=your_super_secret_key_change_this_in_production
OIDC_DISCOVERY_URL=https://login.microsoftonline.com/common/v2.0/.well-known/openid-configuration
OAUTH_CLIENT_ID=your_client_id
OAUTH_CLIENT_SECRET=your_client_secret
OAUTH_REDIRECT_URI=http://localhost:3000/callback

# File Upload
MAX_UPLOAD_SIZE_MB=50

# Virus Scanning
ENABLE_VIRUS_SCAN=False
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# Logging
LOG_LEVEL=INFO
AUDIT_LOG_ENABLED=True

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
